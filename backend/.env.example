# =====================================================================
# backend/.env.example  -  copy to backend/.env and fill in.
# Never commit backend/.env. Every value below is read by backend/settings.py.
# =====================================================================

# ---- Django core -----------------------------------------------------
# [REQUIRED] Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# [OPTIONAL] True only on your own machine. Default False.
DJANGO_DEBUG=False
# [OPTIONAL] Comma-separated hostnames Django will serve. Default 127.0.0.1,localhost
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# [OPTIONAL] Comma-separated origins allowed to submit CSRF-protected forms (Django admin).
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# [OPTIONAL] Comma-separated frontend origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# [OPTIONAL] Log level: DEBUG, INFO, WARNING, ERROR. Default INFO. Logs are PII-masked.
LOG_LEVEL=INFO

# ---- Database --------------------------------------------------------
# [OPTIONAL] Leave unset to use backend/db.sqlite3.
# PostgreSQL is required in production and for concurrency tests, e.g.
#   DATABASE_URL=postgres://ecom:ecom@127.0.0.1:5432/ecom
# DATABASE_URL=

# ---- Storefront & business time --------------------------------------
# [REQUIRED] Public URL of the React storefront (no trailing slash). Used in emails and payment redirects.
SITE_URL=http://localhost:5173
# [OPTIONAL] Timezone for business rules (cutoffs, windows, daily jobs). DB always stores UTC.
BUSINESS_TIME_ZONE=Asia/Kolkata

# ---- Email -----------------------------------------------------------
# [OPTIONAL] Development: django.core.mail.backends.console.EmailBackend prints emails to the terminal.
# Production default: anymail.backends.mailgun.EmailBackend
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# [OPTIONAL] Sender address for all outgoing email.
DEFAULT_FROM_EMAIL=noreply@yourbrand.in
# [NEEDS YOUR CREDENTIALS when using Mailgun]
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=

# ---- Razorpay (primary payments) -------------------------------------
# [NEEDS YOUR CREDENTIALS] Dashboard > Account & Settings > API Keys (use Test Mode first).
# Leave blank and "UPI / Card / Netbanking" returns 503; Cash on Delivery still works.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# [NEEDS YOUR CREDENTIALS] The secret you type when adding the webhook in the Razorpay dashboard
# (Account & Settings > Webhooks). At least 32 random characters. NOT the key secret.
RAZORPAY_WEBHOOK_SECRET=
# [OPTIONAL] Default https://api.razorpay.com
RAZORPAY_API_BASE=https://api.razorpay.com
# [OPTIONAL] Comma-separated payment methods offered: razorpay, cod, stripe, paypal. Default razorpay,cod
ENABLED_PAYMENT_PROVIDERS=razorpay,cod
# [OPTIONAL] Minutes before an unconfirmed prepaid order is checked with Razorpay directly. Default 3.
PAYMENT_RECONCILE_AFTER_MINUTES=3
# [OPTIONAL] Name shown in the Razorpay window and in order emails. Default "Noore Candles".
STORE_NAME=Noore Candles
# [OPTIONAL] Days after delivery before the one review-request email. Default 7.
REVIEW_REQUEST_DELAY_DAYS=7
# [OPTIONAL] Hours a guest's "create your account" link stays valid. Default 48.
ACCOUNT_CLAIM_LINK_HOURS=48

# ---- Legacy payment providers (to be replaced by Razorpay) -----------
# [OPTIONAL] Leave blank to disable; the checkout endpoints then return 503 for that method.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET_ID=
# [OPTIONAL] Sandbox by default. Live: https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ---- Security tuning -------------------------------------------------
# [OPTIONAL] Minutes a password-reset link stays valid. Default 30.
PASSWORD_RESET_TOKEN_MINUTES=30
# [OPTIONAL] DRF throttle rates (requests per sec/min/hour/day).
THROTTLE_ANON=300/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min
THROTTLE_OTP=5/min
THROTTLE_CHECKOUT=60/min
THROTTLE_REVIEW=10/min
THROTTLE_WEBHOOK=600/min

# ---- Inventory -------------------------------------------------------
# [OPTIONAL] FEFO (first expiry first out) or FIFO. Default FEFO.
STOCK_ALLOCATION_STRATEGY=FEFO
# [OPTIONAL] Minutes stock is held for an in-progress checkout before being released. Default 30.
STOCK_RESERVATION_TTL_MINUTES=30
# [OPTIONAL] A batch expiring within this many days is never auto-allocated. Default 30.
MIN_SHELF_LIFE_ON_DISPATCH_DAYS=30
# [OPTIONAL] Owner alert horizon for batches approaching expiry, in days. Default 45.
EXPIRY_ALERT_DAYS=45

# ---- Storefront ------------------------------------------------------
# [OPTIONAL] False: strike through the MRP whenever MRP > price. True: strike a price only when
# the recorded price history shows a higher price in the window before the current price. Default False.
STRIKETHROUGH_REQUIRES_PRICE_HISTORY=False
# [OPTIONAL] Days of price history looked at when the flag above is True. Default 30.
PRICE_HISTORY_WINDOW_DAYS=30
# [OPTIONAL] "Only N left" is shown when real available stock is at or below this. Default 5.
LOW_STOCK_THRESHOLD=5

# ---- Orders ----------------------------------------------------------
# [OPTIONAL] Hours before an unpaid order draft is expired by the worker (stock holds and the
# coupon use are released). Keep above 26. Default 48.
ORDER_DRAFT_TTL_HOURS=48

# ---- Job worker (python manage.py run_worker) ------------------------
# [OPTIONAL] Retries before a failing job is marked DEAD. Default 5.
JOB_MAX_ATTEMPTS=5
# [OPTIONAL] Seconds the worker sleeps when there is nothing to do. Default 5.
JOB_WORKER_SLEEP_SECONDS=5
# [OPTIONAL] A RUNNING job older than this (seconds) is assumed orphaned and retried. Default 600.
JOB_STALE_AFTER_SECONDS=600

# ---- Production (see docs/DEPLOY.md) ---------------------------------
# [OPTIONAL] Redirect plain HTTP to HTTPS when DEBUG is off. Default True.
SECURE_SSL_REDIRECT=True
# [OPTIONAL] HSTS lifetime in seconds when DEBUG is off. Default 3600; raise to 31536000 once HTTPS is proven.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# [OPTIONAL] locmem (per process) or db (shared table; run `python manage.py createcachetable` once).
# Default: locmem when DEBUG is on, db when it is off.
# DJANGO_CACHE=db
# [NEEDS YOUR VALUE in production] Comma-separated addresses that receive backend error reports. Blank = none.
ERROR_REPORT_EMAILS=
# [OPTIONAL] Minimum seconds between two emails for the same error. Default 300.
ERROR_REPORT_MIN_INTERVAL_SECONDS=300
# [OPTIONAL] Seconds without a finished job before the health check calls the worker down. Default 300.
WORKER_STALE_AFTER_SECONDS=300
# [OPTIONAL, production] Absolute path to frontend/dist/index.html, for link previews of product pages.
FRONTEND_INDEX_PATH=
