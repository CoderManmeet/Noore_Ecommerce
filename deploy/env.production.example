# Production values for backend/.env on the server. Every variable is documented in
# backend/.env.example; this file shows only what differs in production.
# Never commit the real file.
DJANGO_SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=shop.example.in
CSRF_TRUSTED_ORIGINS=https://shop.example.in
CORS_ALLOWED_ORIGINS=https://shop.example.in
SITE_URL=https://shop.example.in
DATABASE_URL=postgres://noore:CHANGE-ME@127.0.0.1:5432/noore
DJANGO_CACHE=db
FRONTEND_INDEX_PATH=/srv/noore/frontend/dist/index.html
STORE_NAME=Noore Candles

# Email: a real provider, verified sending domain (SPF and DKIM).
DJANGO_EMAIL_BACKEND=anymail.backends.mailgun.EmailBackend
DEFAULT_FROM_EMAIL=orders@example.in
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=
ERROR_REPORT_EMAILS=you@example.in

# Razorpay LIVE keys and the LIVE webhook secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ENABLED_PAYMENT_PROVIDERS=razorpay,cod

# Start HSTS at an hour; raise to 31536000 after a week of working HTTPS.
SECURE_HSTS_SECONDS=3600
