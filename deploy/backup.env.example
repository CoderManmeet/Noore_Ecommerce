# deploy/backup.env.example - copy to deploy/backup.env on the server. Never commit backup.env.
# Where backups are written on the server.
BACKUP_DIR=/var/backups/noore
# Uploaded product images.
MEDIA_DIR=/srv/noore/backend/media
# Days of backups kept, locally and off-site.
BACKUP_KEEP_DAYS=14
# [NEEDS YOUR VALUE] Off-site copy. An rclone remote and path, e.g. "b2:noore-backups" or
# "s3:noore-backups". Configure the remote once with `rclone config`. Leave blank and the
# backup stays on the server only, which does NOT protect you if the server is lost.
BACKUP_REMOTE=
