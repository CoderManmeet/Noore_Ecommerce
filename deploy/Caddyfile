# Caddy configuration for the Noore Candles store: one domain serves everything.
#
#   /api/*, /admin/*               -> Django (gunicorn on 127.0.0.1:8000)
#   /robots.txt, /sitemap.xml      -> Django
#   /detail/*                      -> Django (product pages with link-preview tags; see core/seo.py)
#   /static/*                      -> Django's collected static files (admin CSS and JS)
#   /media/*                       -> uploaded product images
#   everything else                -> the built React storefront (frontend/dist)
#
# Caddy gets and renews the HTTPS certificate by itself and redirects HTTP to HTTPS.
# The two values below come from the environment (set in /etc/caddy/noore.env, see DEPLOY.md):
#   SITE_ADDRESS   your domain, e.g. shop.example.in
#   APP_ROOT       where the repository lives on the server, e.g. /srv/noore
{$SITE_ADDRESS} {
	encode zstd gzip

	# A request body larger than this is refused (product image uploads are the largest).
	request_body {
		max_size 25MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}

	@django path /api/* /admin/* /robots.txt /sitemap.xml /detail/*
	handle @django {
		reverse_proxy 127.0.0.1:8000
	}

	handle_path /static/* {
		root * "{$APP_ROOT}/backend/staticfiles"
		header Cache-Control "public, max-age=604800"
		file_server
	}

	handle_path /media/* {
		root * "{$APP_ROOT}/backend/media"
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Vite fingerprints everything under /assets/, so it can be cached for a year. A missing
	# asset is a real 404 (never the app page), so a stale tab fails loudly instead of oddly.
	handle /assets/* {
		root * "{$APP_ROOT}/frontend/dist"
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the React app. index.html is never cached, so a deploy shows at once.
	handle {
		root * "{$APP_ROOT}/frontend/dist"
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
